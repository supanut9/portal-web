{
  "name": "portal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=65536' next dev --port 3009",
    "build": "next build",
    "start": "next start --port 3009",
    "lint": "eslint",
    "prepare": "husky",
    "security:semgrep": "semgrep scan --config auto --error .",
    "security:trivy": "trivy filesystem --scanners vuln --severity HIGH,CRITICAL --include-dev-deps --skip-dirs node_modules --skip-dirs .next --skip-dirs output --exit-code 1 .",
    "check:pre-commit": "bun run security:semgrep",
    "check:pre-push": "bun run security:semgrep && bun run security:trivy"
  },
  "dependencies": {
    "better-auth": "^1.5.6",
    "clsx": "^2.1.1",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.1.0",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
